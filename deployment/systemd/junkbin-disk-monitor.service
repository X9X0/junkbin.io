[Unit]
Description=Junkbin.io Disk Space Monitor
# network-online, not plain network.target: alerts now go out over SMTP, so a
# disk-full condition detected at boot would otherwise fire before the network
# is routable and fail to send. network.target only means networking has
# started, not that a connection is usable.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Substituted with the real install path by install_systemd_unit() in
# junkbin-deploy.sh. Installing by hand? Replace __DEPLOY_DIR__.
EnvironmentFile=-/etc/default/junkbin-monitor
ExecStart=__DEPLOY_DIR__/deployment/disk-monitor.sh
