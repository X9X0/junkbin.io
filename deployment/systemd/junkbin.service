[Unit]
Description=Junkbin.io Docker Compose Stack
Documentation=https://github.com/yourusername/junkbin.io
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Substituted with the real install path by install_systemd_unit() in
# junkbin-deploy.sh. Installing by hand? Replace __DEPLOY_DIR__.
WorkingDirectory=__DEPLOY_DIR__
# Explicit -f matches the documented prod convention (docs/RUNBOOK.md): a bare
# `docker compose` merges docker-compose.override.yml, which is gitignored and
# per-environment, so a systemd start would silently differ from a manual one.
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.yml restart
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
