# Junkbin.io - log rotation
# Rotates logs inside the Docker nginx_logs and backend_logs volumes
# Install: cp deployment/logrotate/junkbin /etc/logrotate.d/junkbin

/var/lib/docker/volumes/*_nginx_logs/_data/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    sharedscripts
    postrotate
        docker exec junkbin_nginx nginx -s reopen 2>/dev/null || true
    endscript
}

# backend/celery/celery-beat write with a plain (non-rotating) FileHandler -
# see backend/config/settings/production.py - so use copytruncate rather than
# a postrotate reopen signal, since the app never gets told to reopen the file.
/var/lib/docker/volumes/*_backend_logs/_data/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    copytruncate
}

# certbot renewal output from the cron installed by junkbin-deploy.sh.
# Small and append-only, but rotated so a chatty failure loop can't fill /var.
/var/log/junkbin-certbot-renew.log {
    monthly
    missingok
    rotate 12
    compress
    delaycompress
    notifempty
    copytruncate
}

# Backup cron output from the cron installed by junkbin-deploy.sh.
/var/log/junkbin-backup.log {
    monthly
    missingok
    rotate 12
    compress
    delaycompress
    notifempty
    copytruncate
}
