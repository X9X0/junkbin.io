# Junkbin.io Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ========================================
# Django Settings
# ========================================
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-64
DEBUG=False
ALLOWED_HOSTS=junkbin.io,www.junkbin.io,localhost

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgresql://junkbin:your-db-password@postgres:5432/junkbin
POSTGRES_DB=junkbin
POSTGRES_USER=junkbin
POSTGRES_PASSWORD=your-secure-database-password

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ========================================
# Email Configuration (SMTP)
# ========================================
# For Gmail:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# For SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# ========================================
# OAuth Configuration
# ========================================
# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (future)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Microsoft OAuth (future)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ========================================
# File Storage Configuration
# ========================================
# Options: 'local' or 's3'
STORAGE_BACKEND=local

# Local storage
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/static

# S3 storage (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=junkbin-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_FILE_OVERWRITE=False

# ========================================
# Site Configuration
# ========================================
SITE_URL=https://junkbin.io
SITE_NAME=Junkbin.io
ADMIN_EMAIL=admin@junkbin.io

# ========================================
# Security Settings
# ========================================
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ========================================
# API Rate Limiting
# ========================================
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=default

# Requests per minute for different endpoints
RATELIMIT_AUTH=10/m
RATELIMIT_API=100/h
RATELIMIT_SEARCH=30/m
RATELIMIT_UPLOAD=5/h

# ========================================
# Celery Configuration
# ========================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# ========================================
# Image Processing
# ========================================
# Maximum upload size in MB
MAX_UPLOAD_SIZE=10
# Image quality for thumbnails (1-100)
THUMBNAIL_QUALITY=85
# Thumbnail sizes
THUMBNAIL_SMALL=150x150
THUMBNAIL_MEDIUM=300x300
THUMBNAIL_LARGE=800x800

# ========================================
# Moderation Settings
# ========================================
# Number of reports before auto-review
AUTO_REVIEW_THRESHOLD=3
# Minimum reputation for trusted user status
TRUSTED_USER_REPUTATION=100

# ========================================
# External API Keys (Future Integrations)
# ========================================
# Octopart API
OCTOPART_API_KEY=

# DigiKey API
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Mouser API
MOUSER_API_KEY=

# ========================================
# Monitoring & Analytics (Future)
# ========================================
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=

# ========================================
# Development Overrides
# ========================================
# Set to True only in development
# DEBUG=True
# ALLOWED_HOSTS=*
# CSRF_COOKIE_SECURE=False
# SESSION_COOKIE_SECURE=False
# AUTH_COOKIE_SECURE=False
# SECURE_SSL_REDIRECT=False
