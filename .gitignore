# ========================================
# Private Documentation
# ========================================
Docs/

# ========================================
# Project Specific
# ========================================
# User uploaded media files (keep structure, ignore content)
/backend/media/*
!/backend/media/.gitkeep

# Static files (generated)
/backend/staticfiles/*
!/backend/staticfiles/.gitkeep

# Frontend build
/frontend/dist/
/frontend/build/

# Database dumps
*.sql.gz
